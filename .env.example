# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# BigQuery Configuration
BIGQUERY_DATASET=rag_poc

# Vertex AI Models
VERTEX_EMBEDDING_MODEL=textembedding-gecko@003
VERTEX_GENERATION_MODEL=gemini-1.5-flash

# Optional: Use different Vertex AI models
# VERTEX_EMBEDDING_MODEL=textembedding-gecko-multilingual@001
# VERTEX_GENERATION_MODEL=gemini-1.5-pro

# Dataset Configuration
NUM_TEST_DOCS=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Performance Settings
BATCH_SIZE=100

# Security Settings (for service account)
# Leave blank for Cloud Shell auto-authentication
GOOGLE_APPLICATION_CREDENTIALS=

# Deployment Settings
AUTO_CREATE_RESOURCES=true
VERBOSE_LOGGING=true