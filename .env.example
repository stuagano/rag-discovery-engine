# BigQuery RAG Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
BIGQUERY_DATASET=rag_poc

# Embedding Model Options
# Options: vertex, openai, huggingface, sentence_transformers
EMBEDDING_MODEL=vertex
EMBEDDING_MODEL_NAME=textembedding-gecko@003

# OpenAI Configuration (if using OpenAI embeddings)
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=text-embedding-3-small

# Hugging Face Configuration (if using HF embeddings)
HUGGINGFACE_API_KEY=your-hf-key
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Authentication (Cloud Shell auto-detects, leave blank for Cloud Shell)
GOOGLE_APPLICATION_CREDENTIALS=

# Dataset Configuration
NUM_TEST_DOCS=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Performance Settings
MAX_CONCURRENT_EMBEDDINGS=10
BATCH_SIZE=100

# Security Settings
SERVICE_ACCOUNT_EMAIL=rag-service@your-project-id.iam.gserviceaccount.com
ENABLE_ROW_LEVEL_SECURITY=true

# Deployment Settings
AUTO_CREATE_RESOURCES=true
SKIP_EXISTING_DATA=true
VERBOSE_LOGGING=true