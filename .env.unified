# ========================================
# Unified RAG Configuration
# Single .env for all RAG implementations
# ========================================

# === DEPLOYMENT SELECTION ===
# Choose which RAG to deploy: bigquery_basic, bigquery_enhanced, rag_engine, or all
RAG_DEPLOYMENT_MODE=bigquery_enhanced

# === GOOGLE CLOUD CONFIGURATION ===
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# === BIGQUERY CONFIGURATION (Basic & Enhanced) ===
BIGQUERY_DATASET=rag_unified
BIGQUERY_LOCATION=US

# === RAG ENGINE CONFIGURATION ===
RAG_CORPUS_NAME=manufacturing_docs
RAG_CORPUS_DESCRIPTION=Manufacturing documentation RAG corpus
GCS_BUCKET_SUFFIX=rag-documents

# === VERTEX AI MODELS (All Implementations) ===
VERTEX_EMBEDDING_MODEL=textembedding-gecko@003
VERTEX_GENERATION_MODEL=gemini-1.5-flash
# Alternative: gemini-1.5-pro for better quality

# === DOCUMENT PROCESSING ===
NUM_TEST_DOCS=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SPLIT_STRATEGY=recursive
# Options: simple, sentence, recursive

# === PERFORMANCE SETTINGS ===
BATCH_SIZE=100
MAX_WORKERS=4

# === ENHANCED FEATURES (BigQuery Enhanced Only) ===
ENABLE_HYBRID_SEARCH=true
ENABLE_CACHING=true
ENABLE_RERANKING=true
CACHE_TTL_HOURS=24

# === RAG ENGINE FEATURES ===
RAG_ENGINE_PARSE_MODE=default
# Options: default, layout_parser, llm_parser
RAG_ENGINE_CHUNK_SIZE=512
RAG_ENGINE_CHUNK_OVERLAP=100

# === DEPLOYMENT OPTIONS ===
AUTO_CREATE_RESOURCES=true
AUTO_ENABLE_APIS=true
AUTO_AUTHENTICATE=true
VERBOSE_LOGGING=true
RUN_TESTS_AFTER_DEPLOY=true

# === COST LIMITS (Optional) ===
MONTHLY_BUDGET_USD=50
ALERT_EMAIL=

# === FEATURE FLAGS ===
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_AUTO_BACKUP=false

# === DATA SOURCES ===
# Choose data source: synthetic, wikipedia, arxiv, patents, nist, or all
DATA_SOURCE=synthetic
# Or use real public data
USE_PUBLIC_DATA=false
PUBLIC_DATA_SOURCES=wikipedia,arxiv,patents,nist
MAX_DOCS_PER_SOURCE=5

# === EXTERNAL DATA SOURCES (RAG Engine) ===
# Leave empty to use sample data
GCS_SOURCE_URI=
DRIVE_FOLDER_ID=
SLACK_WORKSPACE_ID=
JIRA_PROJECT_KEY=

# === AUTHENTICATION (Optional) ===
# Leave empty for ADC (Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=
# For service account auth, provide path to key file

# === COMPARISON MODE ===
# Run comparison tests after deployment
RUN_COMPARISON=false
COMPARISON_QUERIES=10